# Example environment variables for the Auth-Rosetta project
# - Edit this file and rename it to .env to use it in your local development environment.

# Database configuration
DB_USER=your_user_name
DB_PASSWORD=your_password

# JWT configuration
JWT_KEY=your_jwt_secret_key

# Frontend configuration
VITE_API_URL=http://localhost:5001

# Docker Compose configuration - Set the profile to use for Docker Compose, net | nest| go | python | java
COMPOSE_PROFILES=net